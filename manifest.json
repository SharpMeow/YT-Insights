{
  "manifest_version": 3,
  "name": "YT Insights \u2014 Revenue, Chapters & Heatmap",
  "version": "1.0.7",
  "description": "Estimated ad revenue, auto chapters, most-replayed heatmap, spam filter, viral strip, and transcript search for YouTube. Estimates only \u2014 not official YouTube data. Coexists with SponsorBlock.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "js/utils.js",
        "js/revenue.js",
        "js/chapters.js",
        "js/heatmap.js",
        "js/spam.js",
        "js/viral.js",
        "js/transcript.js",
        "js/main.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.youtube.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-insights@sharpmeow.github.io",
      "strict_min_version": "121.0"
    }
  }
}
